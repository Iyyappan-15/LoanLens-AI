# ==========================================
# LoanLens AI — Environment Configuration
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL or local SQLite for testing)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loanlens_db
# DATABASE_URL=sqlite+aiosqlite:///./loanlens.db

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider Configuration
# Supported: gemini, openai, mock
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Storage & Uploads
UPLOAD_DIR=./backend/uploads
MAX_FILE_SIZE_MB=25
